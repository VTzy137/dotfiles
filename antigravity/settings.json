{
    "vim.cursorStylePerMode.insert": "line-thin",
    "vim.cursorStylePerMode.normal": "underline",
    "vim.cursorStylePerMode.visual": "block-outline",
    "vim.matchpairs": "(:),{:},[:],<:>",
    "vim.whichwrap": "h,l",
    "vim.easymotion": true,
    "vim.smartRelativeLine": true,
    "vim.surround": true,
    "vim.camelCaseMotion.enable": true,
    "vim.sneak": true,
    "vim.sneakReplacesF": true,
    "vim.useSystemClipboard": true,
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "before": [
                "w"
            ],
            "after": [
                "$"
            ]
        },
        {
            "before": [
                "0"
            ],
            "after": [
                "^"
            ]
        },
        {
            "before": [
                ">"
            ],
            "after": [
                ">",
                "g",
                "v"
            ]
        },
        {
            "before": [
                "<"
            ],
            "after": [
                "<",
                "g",
                "v"
            ]
        },
        {
            "before": [
                "J"
            ],
            "after": [
                "3",
                "j"
            ]
        },
        {
            "before": [
                "K"
            ],
            "after": [
                "3",
                "k"
            ]
        },
        {
            "before": [
                "d"
            ],
            "after": [
                "\"",
                "a",
                "d"
            ]
        }
    ],
    "vim.insertModeKeyBindingsNonRecursive": [],
    "vim.operatorPendingModeKeyBindingsNonRecursive": [
        {
            "before": [
                "w"
            ],
            "after": [
                "$"
            ]
        }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "q",
                "q"
            ],
            "after": [
                ":",
                "q",
                "!",
                "enter"
            ]
        },
        {
            "before": [
                "d"
            ],
            "after": [
                "\"",
                "a",
                "d"
            ]
        },
        {
            "before": [
                "J"
            ],
            "after": [
                "3",
                "j"
            ]
        },
        {
            "before": [
                "K"
            ],
            "after": [
                "3",
                "k"
            ]
        },
        {
            "before": [
                " "
            ],
            "after": [
                "a",
                " ",
                "esc"
            ]
        },
        {
            "before": [
                "f",
                "f"
            ],
            "after": [
                "<leader>",
                "<leader>",
                "<leader>",
                "b",
                "d",
                "w"
            ]
        },
        {
            "before": [
                "t"
            ],
            "after": [
                "<C-r>"
            ]
        },
        {
            "before": [
                "x"
            ],
            "after": [
                "\"",
                "a",
                "x"
            ]
        },
        {
            "before": [
                "d"
            ],
            "after": [
                "\"",
                "a",
                "d"
            ]
        },
        {
            "before": [
                "<tab>"
            ],
            "after": [
                ">",
                ">"
            ]
        },
        {
            "before": [
                "enter"
            ],
            "after": [
                "i",
                "enter",
                "esc"
            ]
        },
        {
            "before": [
                "w"
            ],
            "after": [
                "$"
            ]
        },
        {
            "before": [
                "0"
            ],
            "after": [
                "^"
            ]
        }
    ],
    "workbench.colorTheme": "Noctis Obscuro",
    "editor.cursorBlinking": "solid",
    "files.autoSave": "afterDelay",
    "files.autoSaveWhenNoErrors": true,
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "*.csv": "gc-excelviewer-csv-editor",
        "*.md": "default",
        "*.svg": "default"
    },
    "[html]": {
        "editor.comments.insertSpace": true,
        "editor.defaultFormatter": "vscode.html-language-features",
        "editor.tabSize": 2
    },
    "[typescript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[scss]": {
        "editor.defaultFormatter": "vscode.css-language-features",
        "editor.tabSize": 2
    },
    "[python]": {
        "diffEditor.ignoreTrimWhitespace": false,
        "editor.formatOnType": true,
        "editor.wordBasedSuggestions": "off"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[vue]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "explorer.confirmDelete": false,
    "editor.wordWrap": "on",
    "editor.glyphMargin": false,
    "editor.fontFamily": "'Fira Code', 'monospace', monospace",
    "editor.fontWeight": "440",
    "editor.fontLigatures": true,
    "editor.minimap.enabled": false,
    "window.density.editorTabHeight": "compact",
    "editor.showFoldingControls": "never",
    "csv-preview.lineNumbers": "source",
    "jupyter.askForKernelRestart": false,
    "notebook.editorOptionsCustomizations": {
        "editor.tabSize": 2,
        "editor.indentSize": 2,
        "editor.insertSpaces": true
    },
    "editor.tabSize": 2,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.unicodeHighlight.invisibleCharacters": false,
    "workbench.iconTheme": "material-icon-theme",
    "material-icon-theme.hidesExplorerArrows": true,
    "zenMode.centerLayout": false,
    "zenMode.hideLineNumbers": false,
    "zenMode.hideStatusBar": false,
    // "zenMode.hideActivityBar": false,
    "editor.renderWhitespace": "none",
    "window.customTitleBarVisibility": "windowed",
    "window.zoomLevel": -1,
    "editor.fontSize": 12,
    "terminal.integrated.fontSize": 12,
    "terminal.integrated.fontFamily": "FiraCode Nerd Font",
    "debug.console.fontSize": 12,
    "python.defaultInterpreterPath": "/bin/python3",
    "dart.debugExternalPackageLibraries": false,
    "dart.debugSdkLibraries": false,
    "code-runner.executorMap": {
        "dart": "dart --enable-asserts",
        "csharp": "cd $dir && dotnet run $fileName"
    },
    // "code-runner.runInTerminal": true,
    "workbench.activityBar.location": "top",
    "zenMode.restore": true,
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "workbench.productIconTheme": "icons-carbon",
    "yaml.disableSchemaDetection": [
        "**/docker-compose.yml",
        "**/docker-compose.yaml",
        "**/docker-compose.*.yml",
        "**/docker-compose.*.yaml",
        "**/compose.yml",
        "**/compose.yaml",
        "**/compose.*.yml",
        "**/compose.*.yaml"
    ],
    "python.languageServer": "None",
    "[csharp]": {
        "editor.defaultFormatter": "dotnetdev-kr-custom.csharp"
    },
    "debug.inlineValues": false,
    "editor.semanticTokenColorCustomizations": {
        "rules": {
            "interface": {
                "foreground": "#b8ce82"
            },
            "namespace": "#cccccc",
            "enum": "#b8ce82",
            "struct": {
                "foreground": "#86C691"
            },
            "inactive": {
                "foreground": "#6A6A6A"
            }
        }
    },
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "entity.name.type.interface.cs",
                "settings": {
                    "foreground": "#b8ce82"
                }
            },
            {
                "scope": "entity.name.type.enum.cs",
                "settings": {
                    "foreground": "#b8ce82"
                }
            },
            {
                "scope": "entity.name.type.struct.cs",
                "settings": {
                    "foreground": "#86C691"
                }
            },
            {
                "scope": "variable.other.enummember.cs",
                "settings": {
                    "foreground": "#4FC1FF"
                }
            }
        ]
    },
    "editor.acceptSuggestionOnCommitCharacter": false,
    "editor.autoClosingBrackets": "beforeWhitespace",
}
    